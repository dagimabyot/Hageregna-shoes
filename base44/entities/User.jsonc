{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string",
      "format": "uri"
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_admin_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}