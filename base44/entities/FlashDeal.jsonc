{
  "name": "FlashDeal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_image": {
      "type": "string",
      "format": "uri"
    },
    "original_price": {
      "type": "number"
    },
    "discount_percentage": {
      "type": "number"
    },
    "deal_price": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "product_id",
    "discount_percentage",
    "start_date",
    "end_date"
  ]
}