{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "discount_price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "Men",
        "Women",
        "Kids",
        "Formal",
        "Casual",
        "Leather"
      ]
    },
    "brand": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Unisex",
        "Kids"
      ],
      "default": "Unisex"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "string"
    },
    "comfort_type": {
      "type": "string",
      "enum": [
        "Walking",
        "Formal",
        "Sports",
        "Casual",
        "All-Purpose"
      ]
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "sold_quantity": {
      "type": "number",
      "default": 0
    },
    "sku": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_flash_deal": {
      "type": "boolean",
      "default": false
    },
    "is_trending": {
      "type": "boolean",
      "default": false
    },
    "is_best_seller": {
      "type": "boolean",
      "default": false
    },
    "is_new_arrival": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}