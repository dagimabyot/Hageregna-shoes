{
  "name": "DeliveryZone",
  "type": "object",
  "properties": {
    "zone_name": {
      "type": "string"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "estimated_time": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "zone_name",
    "delivery_fee"
  ]
}